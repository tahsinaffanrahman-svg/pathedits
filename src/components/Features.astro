---
---

<section class="benefits">
  <div class="container">
    <div class="grid">
      <div class="column">
        <div class="card light-blue">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/fast-image-delivery-six-hours-illustration.svg" alt="Fast edits" />
          </div>
          <div class="text-wrap">
            <h2 class="large">Fast edits</h2>
            <p>Choose from 6-, 12-, or 24-hour turnaround</p>
          </div>
        </div>
        <div class="card lavender">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/under-budget-cost-effective-icon.svg" alt="Budget-friendly" />
          </div>
          <div class="text-wrap">
            <h2>Budget-friendly</h2>
            <p>Edits start at just $0.25 per image</p>
          </div>
        </div>
      </div>
      <div class="column">
        <div class="card lavender">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/customer-support-24-7-illustration.svg" alt="24/7 support" />
          </div>
          <div class="text-wrap">
            <h2>24/7 support</h2>
            <p>Smash even the tightest deadline</p>
          </div>
        </div>
        <div class="card light-blue">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/pixel-perfect-results-illustration.svg" alt="Pro results" class="pro-results" />
          </div>
          <div class="text-wrap">
            <h2>Pro results</h2>
            <p>Every image is edited by hand by a seasoned pro</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefits {
    background: #FFFFFF;
    padding: 80px 0;
  }
  .container {
    max-width: 1256px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .column {
    display: flex;
    flex-direction: column;
    gap: 31px;
  }
  .card {
    display: flex;
    align-items: center;
    border-radius: 20px;
    padding: 24px 32px;
    gap: 24px;
    min-height: 120px;
    box-sizing: border-box;
  }
  .card.light-blue {
    background: #E8F4FE;
  }
  .card.lavender {
    background: #F1EFFE;
  }
  .icon-wrap {
    flex: 0 0 90px;
    width: 90px;
    height: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .icon-wrap img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .text-wrap {
    flex: 1;
  }
  h2 {
    font-family: 'Livvic', sans-serif;
    color: #2B1B9A;
    font-weight: 600;
    margin: 0 0 8px 0;
    font-size: 24px;
    line-height: 1.3;
  }
  p {
    font-family: 'Asap', sans-serif;
    color: #5F5572;
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
