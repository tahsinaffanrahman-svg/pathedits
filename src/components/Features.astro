<section class="benefits">
  <div class="container">
    <div class="grid">
      <div class="column">
        <div class="card light-blue">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/fast-image-delivery-six-hours-illustration.svg" alt="Fast edits" />
          </div>
          <div class="text-wrap">
            <h2 class="large">Fast edits</h2>
            <p>Choose from 6-, 12-, or 24-hour turnaround</p>
          </div>
        </div>
        <div class="card lavender">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/under-budget-cost-effective-icon.svg" alt="Budget-friendly" />
          </div>
          <div class="text-wrap">
            <h2>Budget-friendly</h2>
            <p>Edits start at just $0.25 per image</p>
          </div>
        </div>
      </div>
      <div class="column">
        <div class="card lavender">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/customer-support-24-7-illustration.svg" alt="24/7 support" />
          </div>
          <div class="text-wrap">
            <h2>24/7 support</h2>
            <p>Smash even the tightest deadline</p>
          </div>
        </div>
        <div class="card light-blue">
          <div class="icon-wrap">
            <img src="https://cdn.pathedits.com/Illustrations/pixel-perfect-results-illustration.svg" alt="Pro results" class="pro-results" />
          </div>
          <div class="text-wrap">
            <h2>Pro results</h2>
            <p>Every image is edited by hand by a seasoned pro</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefits {
    background: #FFFFFF;
    padding: 100px 0;
  }
  .benefits .container {
    max-width: 1440px !important;
    margin: 0 auto;
    padding: 0 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .column {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .card {
    display: flex;
    align-items: center;
    border-radius: 28px;
    padding: 44px 52px;
    gap: 36px;
    min-height: 170px;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .card.light-blue {
    background: #E8F4FE;
  }
  .card.lavender {
    background: #F1EFFE;
  }
  .icon-wrap {
    flex: 0 0 120px;
    width: 120px;
    height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .icon-wrap img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .text-wrap {
    flex: 1;
  }
  h2 {
    font-family: 'Livvic', sans-serif;
    color: #2B1B9A;
    font-weight: 700;
    margin: 0 0 10px 0;
    font-size: 28px;
    line-height: 1.25;
  }
  h2.large {
    font-size: 32px;
  }
  p {
    font-family: 'Asap', sans-serif;
    color: #5F5572;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }

  /* 1. Desktop (>1024px): Default styles above */

  /* 2. Tablet (max-width: 1024px) */
  @media (max-width: 1024px) {
    .benefits {
      padding: 80px 0;
    }
    .benefits .container {
      padding: 0 24px;
    }
    .card {
      padding: 32px 36px;
      gap: 24px;
      min-height: 140px;
    }
    .icon-wrap {
      flex: 0 0 90px;
      width: 90px;
    }
  }

  /* 3. Mobile (max-width: 768px) */
  @media (max-width: 768px) {
    .benefits {
      padding: 56px 0;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .column {
      gap: 24px;
    }
    .card {
      flex-direction: row;
      text-align: left;
      padding: 24px 28px;
    }
  }

  @media (max-width: 480px) {
    .card {
      flex-direction: column;
      text-align: center;
      padding: 24px 20px;
    }
  }
</style>
