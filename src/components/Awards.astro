---
// Awards and Recognitions component with infinite loop carousel
const awards = [
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/path-bitpa-conference-2025-community-sponsor-award.png?w=400",
    h3: "Community Sponsor",
    p: "BITPA Conference 2025"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/basis-outsourcing-award-2015-startup-company-trophy.png?w=400",
    h3: "Startup Company",
    p: "From BASIS Outsourcing Award 2015"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/digital-udvaboni-mela-2017-appreciation-crest.png?w=400",
    h3: "Appreciation Crest",
    p: "From Digital Uddokta Mela 2017"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/basis-outsourcing-award-2015-logo.png?w=400",
    h3: "BASIS Outsourcing Award",
    p: "2015"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/digital-udvaboni-mela-2017-blue-logo.png?w=400",
    h3: "Digital Udvaboni Mela",
    p: "2017"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/freelancers-meet-award-2016-blue-logo.png?w=400",
    h3: "Freelancers Meet Award",
    p: "2016"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/path-career-summit-2025-appreciation-award.png?w=400",
    h3: "Award of Appreciation",
    p: "Career Summit 2025"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/career-summit-2025-blue-logo.png?w=400",
    h3: "Career Summit",
    p: "2025"
  },
  {
    img: "https://cdn.pathedits.com/Images/pages/home/path-awards/bitpa-conference-2025-blue-logo.png?w=400",
    h3: "BITPA Conference",
    p: "2025"
  }
];
---

<section class="pe-awards">
  <div class="container">
    <h2 class="section-title">Awards and recognitions</h2>

    <div class="awards-slider-container">
      <button class="slider-arrow arrow-prev" id="awards-prev-btn" aria-label="Previous awards">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2B1B9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="slider-viewport" id="awards-viewport">
        <div class="slider-track" id="awards-slider-track">
          {awards.map(award => (
            <div class="award-slide">
              <div class="award-card">
                <img src={award.img} alt={award.h3} loading="lazy" />
                <div class="award-text">
                  <h3>{award.h3}</h3>
                  <p>{award.p}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button class="slider-arrow arrow-next" id="awards-next-btn" aria-label="Next awards">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2B1B9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  function setupAwardsSlider() {
    const track = document.getElementById('awards-slider-track');
    const viewport = document.getElementById('awards-viewport');
    const prevBtn = document.getElementById('awards-prev-btn');
    const nextBtn = document.getElementById('awards-next-btn');

    if (!track || !viewport || !prevBtn || !nextBtn) return;

    const slides = Array.from(track.querySelectorAll('.award-slide')) as HTMLElement[];
    const totalSlides = slides.length;
    let currentIndex = 0;

    const getVisibleCount = () => {
      if (window.innerWidth <= 640) return 1;
      if (window.innerWidth <= 1024) return 2;
      return 3;
    };

    const updateSlider = () => {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, totalSlides - visibleCount);
      
      if (currentIndex > maxIndex) {
        currentIndex = 0; // wrap around loop
      } else if (currentIndex < 0) {
        currentIndex = maxIndex;
      }

      const slideWidth = slides[0]?.offsetWidth || 0;
      const gap = 24;
      const offset = currentIndex * (slideWidth + gap);
      track.style.transform = `translateX(-${offset}px)`;
    };

    prevBtn.addEventListener('click', () => {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, totalSlides - visibleCount);
      if (currentIndex === 0) {
        currentIndex = maxIndex;
      } else {
        currentIndex--;
      }
      updateSlider();
    });

    nextBtn.addEventListener('click', () => {
      const visibleCount = getVisibleCount();
      const maxIndex = Math.max(0, totalSlides - visibleCount);
      if (currentIndex >= maxIndex) {
        currentIndex = 0;
      } else {
        currentIndex++;
      }
      updateSlider();
    });

    // Handle touch swipe
    let startX = 0;
    let isTouching = false;

    viewport.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isTouching = true;
    }, { passive: true });

    viewport.addEventListener('touchend', (e) => {
      if (!isTouching) return;
      const endX = e.changedTouches[0].clientX;
      const diffX = startX - endX;

      if (Math.abs(diffX) > 40) {
        if (diffX > 0) {
          nextBtn.click();
        } else {
          prevBtn.click();
        }
      }
      isTouching = false;
    });

    window.addEventListener('resize', updateSlider);
    updateSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAwardsSlider);
  } else {
    setupAwardsSlider();
  }
</script>

<style>
  .pe-awards {
    background-color: #9D91F5;
    padding: 72px 0 96px 0;
    overflow: hidden;
  }

  .container {
    max-width: 1256px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-title {
    color: #FFFFFF;
    font-family: 'Livvic', sans-serif;
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    text-align: center;
    margin: 0 0 54px 0;
  }

  .awards-slider-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 68px; /* Dedicated gutter for floating navigation arrows */
    box-sizing: border-box;
  }

  .slider-viewport {
    width: 100%;
    overflow: hidden;
    padding: 12px 0;
  }

  .slider-track {
    display: flex;
    gap: 24px;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .award-slide {
    flex: 0 0 calc((100% - 48px) / 3);
    width: calc((100% - 48px) / 3);
    box-sizing: border-box;
    display: flex;
  }

  .award-card {
    background: #FFFFFF;
    border-radius: 12px;
    padding: 28px 24px 32px;
    min-height: 310px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
    box-shadow: 0 8px 24px rgba(43, 27, 154, 0.08);
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .award-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(43, 27, 154, 0.14);
  }

  .award-card img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 168px;
    max-height: 168px;
    margin: 0 0 20px 0;
    object-fit: contain;
    object-position: center center;
    flex: 0 0 168px;
  }

  .award-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    flex-grow: 1;
  }

  .award-text h3 {
    color: #2B1B9A;
    font-family: 'Livvic', sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 6px 0;
    text-align: left;
  }

  .award-text p {
    color: #2B1B9A;
    font-family: 'Asap', sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.35;
    margin: 0;
    text-align: left;
  }

  /* Carousel navigation buttons */
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #FFFFFF;
    border: none;
    box-shadow: 0 4px 16px rgba(43, 27, 154, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background-color 0.2s, transform 0.2s;
  }

  .slider-arrow:hover {
    background-color: #F8F6FA;
    transform: translateY(-50%) scale(1.06);
  }

  .arrow-prev {
    left: 8px;
  }

  .arrow-next {
    right: 8px;
  }

  @media (max-width: 1024px) {
    .award-slide {
      flex: 0 0 calc((100% - 24px) / 2);
      width: calc((100% - 24px) / 2);
    }
    .awards-slider-container {
      padding: 0 60px;
    }
  }

  @media (max-width: 640px) {
    .award-slide {
      flex: 0 0 100%;
      width: 100%;
    }
    .awards-slider-container {
      padding: 0 48px;
    }
    .arrow-prev {
      left: 0;
    }
    .arrow-next {
      right: 0;
    }
    .award-text h3 {
      font-size: 20px;
    }
    .award-text p {
      font-size: 16px;
    }
  }
</style>
