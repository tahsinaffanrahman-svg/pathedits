                <span class="arrow-right">&#8250;</span>
              </div>
            </div>
            <input type="range" min="0" max="100" value="50" class="pe-ba-range" aria-label={`Compare before and after for ${service.name}`} />
          </div>
          <div class="pe-svc-info">
            <div class="pe-svc-text">
              <a href={service.link}><h3>{service.name}</h3></a>
              <p class="price">From <strong>{service.price}</strong> per image</p>
