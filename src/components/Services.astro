<script>
  function initSliders() {
    const sliders = document.querySelectorAll<HTMLElement>('[data-slider]');
    sliders.forEach(slider => {
      const range = slider.querySelector<HTMLInputElement>('.pe-ba-range');
      if (!range) return;

      const setPos = (val: string | number) => {
        slider.style.setProperty('--position', `${val}%`);
      };

      range.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        setPos(target.value);
      });

      // Pointer drag interaction
      let isDragging = false;
      const updateFromPointer = (e: MouseEvent | Touch) => {
        const rect = slider.getBoundingClientRect();
        const x = Math.max(0, Math.min(e.clientX - rect.left, rect.width));
        const pct = Math.round((x / rect.width) * 100);
        setPos(pct);
        range.value = pct.toString();
      };

      slider.addEventListener('mousedown', (e) => {
        isDragging = true;
        updateFromPointer(e);
      });
      window.addEventListener('mousemove', (e) => {
        if (isDragging) updateFromPointer(e);
      });
      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      slider.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) updateFromPointer(e.touches[0]);
      }, { passive: true });
      slider.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) updateFromPointer(e.touches[0]);
      }, { passive: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSliders);
  } else {
    initSliders();
  }
</script>

<style>
  .pe-services {
    background-color: #FFFFFF;
    padding: 80px 0;
  }
  .container {
    max-width: 1256px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .section-heading {
    color: #2B1B9A;
    font-family: 'Livvic', sans-serif;
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    text-align: center;
    margin-bottom: 48px;
  }

  .services-row {
    display: grid;
    gap: 24px;
    margin-bottom: 24px;
  }
  .row-2-col {
    grid-template-columns: repeat(2, 1fr);
  }
  .row-3-col {
    grid-template-columns: repeat(3, 1fr);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #E9E6EF;
    box-shadow: 0 4px 16px rgba(43, 27, 154, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .service-card:hover {
    box-shadow: 0 8px 24px rgba(43, 27, 154, 0.08);
  }

  .large-card .pe-before-after {
    height: 400px;
  }
  .small-card .pe-before-after {
    height: 281px;
  }

  .pe-before-after {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f0f0f5;
    user-select: none;
  }

  .pe-ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
  }

  .pe-ba-after {
    z-index: 1;
  }

  .pe-ba-before {
    z-index: 2;
    clip-path: inset(0 calc(100% - var(--position, 50%)) 0 0);
  }

  .pe-ba-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position, 50%);
    width: 2px;
    background-color: #2B1B9A;
    z-index: 4;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .pe-ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #D2EAFC;
    border: 2px solid #FFFFFF;
    box-shadow: 0 2px 8px rgba(43, 27, 154, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    box-sizing: border-box;
  }
  .pe-ba-handle .arrow-left,
  .pe-ba-handle .arrow-right {
    color: #2B1B9A;
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
    user-select: none;
  }

  .pe-ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 5;
    margin: 0;
  }

  /* Bottom info strip */
  .pe-svc-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 28px;
    background: #F8F6FA;
    border-top: 1px solid #E9E6EF;
    min-height: 96px;
    box-sizing: border-box;
    gap: 12px;
  }

  .pe-svc-text a {
    text-decoration: none;
  }
  .pe-svc-text h3 {
    color: #2B1B9A;
    font-family: 'Livvic', sans-serif;
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 4px 0;
    line-height: 1.3;
    transition: color 0.2s;
  }
  .pe-svc-text a:hover h3 {
    color: #9B93EE;
  }
  .pe-svc-text .price {
    color: #2B1B9A;
    font-family: 'Asap', sans-serif;
    font-size: 15px;
    margin: 0;
    line-height: 1.4;
  }
  .pe-svc-text .price strong {
    font-weight: 700;
  }

  .btn-order {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    color: #2B1B9A;
    font-family: 'Asap', sans-serif;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(43, 27, 154, 0.08);
    border: 1px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-order:hover {
    box-shadow: 0 6px 16px rgba(43, 27, 154, 0.14);
    background: #F1EFFE;
  }
  .btn-order span {
    font-size: 16px;
    line-height: 1;
  }

  /* Bottom CTA */
  .pe-services-all {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }
  .btn-all-services {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #67B6F4;
    color: #2B1B9A;
    font-family: 'Asap', sans-serif;
    font-size: 16px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .btn-all-services:hover {
    background: #55A4E2;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .row-2-col,
    .row-3-col {
      grid-template-columns: 1fr;
    }
    .large-card .pe-before-after,
    .small-card .pe-before-after {
      height: 320px;
    }
    .pe-svc-info {
      padding: 20px;
    }
  }
</style>
