---
---

<div class="infobar-wrapper">
	<div class="container infobar-inner">
		<div class="info-slide">
			<img src="https://cdn.pathedits.com/Icons/usd-dollar-price-icon.svg" height="18" alt="USD price icon" />
			<span>From $0.25 per image</span>
		</div>

		<div class="info-divider"></div>

		<div class="info-slide">
			<img src="https://cdn.pathedits.com/Icons/love-heart-icon.svg" height="18" alt="Heart icon" />
			<span>24/7 support</span>
		</div>

		<div class="info-divider"></div>

		<div class="info-slide">
			<img src="https://cdn.pathedits.com/Icons/time-clock-icon.svg" height="18" alt="Clock icon" />
			<span>Turnaround from 6 hours</span>
		</div>

		<div class="info-divider"></div>

		<div class="info-slide">
			<!-- Official Trustpilot Widget - Micro TrustScore -->
			<div 
				class="trustpilot-widget" 
				data-locale="en-US" 
				data-template-id="5419b637fa0340045cd0c936" 
				data-businessunit-id="614492196d2477001d850c10" 
				data-style-height="24px" 
				data-style-width="100%" 
				data-text-color="#2B1B9A"
			>
				<a href="https://uk.trustpilot.com/review/pathedits.com" target="_blank" rel="noopener">Trustpilot</a>
			</div>
		</div>

		<div class="info-divider"></div>

		<div class="info-slide">
			<img src="https://cdn.pathedits.com/Icons/shield-quality-assurance-icon.svg" height="18" alt="Quality icon" />
			<span>Quality guaranteed</span>
		</div>
	</div>
</div>

<style>
	.infobar-wrapper {
		background-color: #eeedf6;
		padding: 10px 0;
		font-size: 14px;
		color: #2b1b9a;
		font-weight: 600;
	}

	.infobar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
	}

	.info-slide {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.info-divider {
		width: 1px;
		height: 18px;
		background-color: rgba(165, 161, 176, 0.3);
	}

	@media (max-width: 768px) {
		.info-divider {
			display: none;
		}
		.infobar-inner {
			justify-content: center;
		}
	}
</style>

<script is:inline src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
