<header class="header-wrapper">
	<div class="container header-inner">
		<!-- Left: Logo -->
		<div class="header-logo">
			<a href="/" aria-label="Pathedits home">
				<img 
					src="https://cdn.pathedits.com/Logos/path-logo-dark-theme.svg" 
					alt="Path brand logo displayed in a dark theme for professional use." 
					style="width: 96px; height: auto;" 
				/>
			</a>
		</div>

		<!-- Center: Navigation Links -->
		<nav class="header-nav" aria-label="Main Navigation">
			<ul class="nav-container">
				<li><a href="/pages/how-it-works"><strong>How it works</strong></a></li>
				<li class="mega-menu-trigger">
					<a href="/pages/services" class="mega-link">
						<strong>Image editing services</strong>
						<img src="https://cdn.pathedits.com/Icons/down-arrow-icon-v2.svg" width="12" alt="Down arrow" />
					</a>

					<!-- Mega Menu -->
					<div class="mega-menu">
						<ul class="mega-grid">
							<li>
								<a href="/pages/clipping-path">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/clipping-path.svg" width="50" alt="Clipping path" />
										<div>
											<h4>Clipping path</h4>
											<p>Get precise background removal and clean cutouts for e-commerce and product images.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/background-removal">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/background-removal.svg" width="50" alt="Background removal" />
										<div>
											<h4>Background removal</h4>
											<p>Achieve flawless images with our background removal service for a clean look.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/image-masking">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/image-making.svg" width="50" alt="Image masking" />
										<div>
											<h4>Image masking</h4>
											<p>Expertly remove backgrounds from hair, fur, and complex borders with image masking.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/drop-shadow">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/shadow.svg" width="50" alt="Shadow" />
										<div>
											<h4>Shadow</h4>
											<p>Add depth and dimension with natural, drop, and reflection shadows.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/ghost-mannequin">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/ghost-mannequin.svg" width="50" alt="Ghost mannequin" />
										<div>
											<h4>Ghost mannequin</h4>
											<p>Elevate apparel images with ghost mannequin services, removing mannequins for a 3D effect.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/symmetrical-edit">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/symmetry.svg" width="50" alt="Symmetrical edit" />
										<div>
											<h4>Symmetrical edit</h4>
											<p>Create perfectly symmetrical apparel product photos that can help boost sales.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/color-variants">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/color-changes.svg" width="50" alt="Color change" />
										<div>
											<h4>Color change</h4>
											<p>Showcase products in various colors with vibrant and accurate color variants.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/photo-retouching">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/photo-retouching.svg" width="50" alt="Photo retouching" />
										<div>
											<h4>Photo retouching</h4>
											<p>Enhance images by refining details and correcting imperfections for a polished look.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/vector-conversion">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/vector-services.svg" width="50" alt="Vector conversion" />
										<div>
											<h4>Vector conversion</h4>
											<p>Convert images to scalable vectors perfect for logos and illustrations.</p>
										</div>
									</div>
								</a>
							</li>
							<li>
								<a href="/pages/multi-clipping-path-services">
									<div class="mega-card">
										<img src="https://cdn.pathedits.com/Icons/multi-clipping-path.svg" width="50" alt="Multi-clipping path" />
										<div>
											<h4>Multi-clipping path</h4>
											<p>Isolate multiple objects and areas with clean cutouts for detailed visuals.</p>
										</div>
									</div>
								</a>
							</li>
						</ul>
					</div>
				</li>
				<li class="mega-menu-trigger">
					<a href="#" class="mega-link">
						<strong>Apps</strong>
						<img src="https://cdn.pathedits.com/Icons/down-arrow-icon-v2.svg" width="12" alt="Down arrow" />
					</a>

					<!-- Apps Mega Menu -->
					<div class="mega-menu apps-mega-menu">
						<ul class="mega-grid apps-grid">
							<li>
								<a href="https://apps.shopify.com/path-catalog-health" target="_blank" rel="noopener">
									<div class="mega-card">
										<img src="https://pathedits.com/wp-content/themes/pathedits/images/shopify-icon.svg" width="50" alt="Shopify Icon" />
										<div>
											<h4 class="apps-title">
												Catalog Health App <span class="nav-new-badge">New</span>
											</h4>
											<p>Scan your Shopify catalog for image issues and fix them fast — new on the Shopify App Store.</p>
										</div>
									</div>
								</a>
							</li>
						</ul>
					</div>
				</li>
				<li><a href="/pages/credits"><strong>Credits</strong></a></li>
				<li><a href="/pages/pricing"><strong>Pricing</strong></a></li>
				<li><a href="/blogs/tips"><strong>Blog</strong></a></li>
				<li><a href="/pages/contact"><strong>Help</strong></a></li>
			</ul>
		</nav>

		<!-- Right: CTA, Currency Switcher, Login -->
		<div class="header-controls">
			<a href="/pages/free-trial" class="wp-block-button__link btn-fill-primary">
				<strong>Get my image edits</strong>
			</a>

			<div class="price-switcher" id="switcher">
				<div class="switcher" id="switcherBtn">
					<span id="currText">USD</span>
					<img src="https://cdn.pathedits.com/Icons/down-arrow-icon-v2.svg" width="10" alt="Down arrow">
				</div>
				<div id="currDropdown" class="currancies" style="display: none">
					<div>
						<a href="#" data-val="USD"><strong>USD</strong></a>
						<a href="#" data-val="EUR">EUR</a>
						<a href="#" data-val="GBP">GBP</a>
						<a href="#" data-val="AUD">AUD</a>
						<a href="#" data-val="CAD">CAD</a>
						<a href="#" data-val="BDT">BDT</a>
					</div>
				</div>
			</div>

			<a href="/pages/contact" class="login-link"><strong>Log in</strong></a>

			<button class="mobile-nav-opener" id="mobileNavOpener" aria-label="Open Menu">
				<img src="https://cdn.pathedits.com/Icons/menu-hamburger.svg" alt="Menu" />
			</button>
		</div>
	</div>
</header>

<style>
	.header-wrapper {
		background-color: #ffffff;
		border-bottom: 1px solid rgba(165, 161, 176, 0.16);
		padding: 16px 0;
		position: relative;
		z-index: 100;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-container {
		display: flex;
		align-items: center;
		gap: 24px;
		list-style: none;
	}

	.nav-container a {
		font-family: 'Asap', sans-serif;
		font-size: 15px;
		color: #332b50;
		font-weight: 600;
	}

	.nav-container a:hover {
		color: #736bcc;
	}

	.mega-menu-trigger {
		position: relative;
	}

	.mega-link {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.mega-menu {
		position: absolute;
		top: 100%;
		left: -100px;
		width: 860px;
		background: #ffffff;
		border-radius: 24px;
		box-shadow: 0px 12px 24px -4px rgba(165, 161, 176, 0.12), 0px 0px 2px 0px rgba(165, 161, 176, 0.2);
		padding: 24px;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease, transform 0.25s ease;
		transform: translateY(10px);
		pointer-events: none;
	}

	.mega-menu-trigger:hover .mega-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(12px);
		pointer-events: auto;
	}

	.apps-mega-menu {
		width: 420px !important;
		left: -50px;
	}

	.apps-grid {
		grid-template-columns: 1fr !important;
	}

	.apps-title {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.nav-new-badge {
		display: inline-block;
		background-color: #736BCC;
		color: #ffffff;
		font-size: 10px;
		font-weight: 700;
		padding: 2px 6px;
		border-radius: 4px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		line-height: 1.2;
	}

	.mega-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px 20px;
		list-style: none;
	}

	.mega-card {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 10px;
		border-radius: 12px;
		transition: background 0.2s ease;
	}

	.mega-card:hover {
		background: rgba(155, 147, 238, 0.08);
	}

	.mega-card h4 {
		font-size: 15px;
		color: #332b50;
		font-weight: 700;
		margin-bottom: 2px;
	}

	.mega-card p {
		font-size: 12px;
		color: #756f85;
		line-height: 1.4;
		font-weight: 400;
	}

	.header-controls {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.login-link {
		font-size: 15px;
		font-weight: 700;
		color: #2b1b9a;
	}

	.mobile-nav-opener {
		display: none;
		background: transparent;
		border: 2px solid rgba(155, 147, 238, 0.12);
		border-radius: 50px;
		padding: 6px;
		cursor: pointer;
	}

	@media (max-width: 960px) {
		.header-nav {
			display: none;
		}
		.mobile-nav-opener {
			display: block;
		}
	}
</style>

<script>
	const switcherBtn = document.getElementById('switcherBtn');
	const currDropdown = document.getElementById('currDropdown');
	const currText = document.getElementById('currText');

	switcherBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		if (currDropdown) {
			currDropdown.style.display = currDropdown.style.display === 'none' ? 'block' : 'none';
		}
	});

	document.querySelectorAll('.currancies a').forEach(a => {
		a.addEventListener('click', (e) => {
			e.preventDefault();
			const val = a.getAttribute('data-val');
			if (val && currText) {
				currText.textContent = val;
			}
			if (currDropdown) currDropdown.style.display = 'none';
		});
	});

	document.addEventListener('click', () => {
		if (currDropdown) currDropdown.style.display = 'none';
	});
</script>
