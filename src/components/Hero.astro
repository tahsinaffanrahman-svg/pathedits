<style>
  .hero-section {
    background-color: #F8F6FA;
    padding: 80px 0 40px;
    font-family: 'Asap', sans-serif;
  }
  
  .hero-section .container {
    max-width: 100% !important;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  .hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 60px;
  }
  
  h1 {
    font-family: 'Livvic', sans-serif;
    color: #282294;
    font-size: clamp(32px, 3.3vw, 48px);
    font-weight: 600;
    margin-bottom: 24px;
    line-height: 1.2;
  }
  
  .subtitle {
    font-family: 'Asap', sans-serif;
    color: #282294;
    font-size: 24px;
    margin-bottom: 40px;
    line-height: 1.4;
  }
  
  .subtitle strong {
    font-weight: 600;
  }
  
  .cta-group {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 32px;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    border-radius: 8px;
    font-family: 'Asap', sans-serif;
    font-weight: 700;
    font-size: 16px;
    min-height: 48px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  
  .btn-primary {
    background-color: #79B5EF;
    color: #2B1B9A;
  }
  
  .btn-primary:hover {
    background-color: #67B6F4;
  }
  
  .btn-secondary {
    background-color: #ffffff;
    color: #282294;
    box-shadow: 0 4px 14px rgba(43,27,154,.10);
  }
  
  .btn-secondary:hover {
    box-shadow: 0 6px 20px rgba(43,27,154,.15);
  }
  
  .shopify-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    font-size: 14px;
    color: #282294;
  }
  
  .shopify-badge a {
    color: #282294;
    font-weight: 700;
    text-decoration: none;
  }
  
  .shopify-badge a:hover {
    text-decoration: underline;
  }
  
  .image-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
  }
  
  .image-tile {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    width: 100%;
    background-color: #eee;
  }
  
  .image-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }
  
  .img-after {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .img-before {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .image-tile:hover .img-before {
    opacity: 1;
  }
  
  .pill {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background-color: #ffffff;
    color: #282294;
    font-size: 13px;
    font-family: 'Asap', sans-serif;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    pointer-events: none;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  
  .pill-text-hover {
    display: none;
  }
  
  .image-tile:hover .pill-text-default {
    display: none;
  }
  
  .image-tile:hover .pill-text-hover {
    display: inline;
  }
  
  /* 1. Desktop (>1024px): Default styles above */

  /* 2. Tablet (max-width: 1024px) */
  @media (max-width: 1024px) {
    .hero-section {
      padding: 60px 0 36px;
    }
    .hero-section .container {
      padding: 0 24px;
    }
    .hero-content {
      margin-bottom: 48px;
    }
    .image-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  
  /* 3. Mobile (max-width: 768px) */
  @media (max-width: 768px) {
    .hero-section {
      padding: 48px 0 32px;
    }
    .hero-section .container {
      padding: 0 16px;
    }
    .hero-content {
      margin-bottom: 36px;
    }
    h1 {
      font-size: 32px;
    }
    .subtitle {
      font-size: 18px;
    }
    .image-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .cta-group {
      flex-direction: column;
      width: 100%;
    }
    .btn {
      width: 100%;
    }
  }
</style>
