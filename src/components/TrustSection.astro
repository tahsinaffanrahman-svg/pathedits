<section class="trust-section">
  <div class="container">
    <div class="trust-grid">
      <!-- Left Column -->
      <div class="trust-card lavender-card">
        <div class="card-top">
          <img src="https://cdn.pathedits.com/Illustrations/trusted-image-editing-services.svg" alt="Trusted Image Editing Services" width="96" class="star-graphic" />
          <img src="https://cdn.pathedits.com/Illustrations/stars.svg" alt="5 Stars" width="88" class="five-stars" />
        </div>
        <h3>Backed by thousands of<br>5-star reviews</h3>
        <p>Path has saved 40,000+ businesses valuable time and money with premium image editing services.</p>
      </div>
      
      <!-- Right Column -->
      <div class="trust-card white-card">
        <div class="trustpilot-widget" data-locale="en-US" data-template-id="539ad0ffdec7e10e686debd7" data-businessunit-id="614492196d2477001d850c10" data-style-height="350px" data-style-width="100%" data-stars="1,2,3,4,5" data-review-languages="en">
          <a href="https://www.trustpilot.com/review/pathedits.com" target="_blank" rel="noopener">Trustpilot</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    background-color: #E2DEFC;
    padding: 80px;
    font-family: 'Asap', sans-serif;
  }
  
  .container {
    max-width: 1256px;
    margin: 0 auto;
  }
  
  .trust-grid {
    display: flex;
    gap: 32px;
    align-items: stretch;
  }
  
  .trust-card {
    display: flex;
    flex-direction: column;
  }
  
  .lavender-card {
    width: 45%;
    background-color: #F1EFFE;
    border-radius: 10px;
    padding: 38px 56px;
  }
  
  .white-card {
    width: 55%;
    background-color: #ffffff;
    border-radius: 12px;
    padding: 38px 56px;
    box-shadow: 0 4px 16px rgba(43,27,154,.06);
  }
  
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }
  
  .lavender-card h3 {
    font-family: 'Livvic', sans-serif;
    color: #2B1B9A;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  
  .lavender-card p {
    font-family: 'Asap', sans-serif;
    color: #2B1B9A;
    font-size: 20px;
    line-height: 1.5;
    margin: 0;
  }
  
  @media (max-width: 992px) {
    .trust-section {
      padding: 60px 24px;
    }
    .trust-grid {
      flex-direction: column;
    }
    .lavender-card, .white-card {
      width: 100%;
    }
  }
  
  @media (max-width: 768px) {
    .lavender-card, .white-card {
      padding: 32px 24px;
    }
  }
</style>
