	<div class="footer-badge-bar">
		<div class="container footer-badge-inner">
			<div class="footer-badge-item">
				<div class="badge-icon-circle">
					<img
						src="https://cdn.pathedits.com/Logos/un-global-compact-logo-on-a-white-rounded-background.svg"
						alt="Official logo of the United Nations Global Compact featuring a globe and laurel wreath design on a white rounded background."
						width="86"
						height="86"
					/>
				</div>
				<div class="badge-text">
					<p>Path is a UN Global Compact partner, dedicated to socially conscious and sustainable business practices. <strong><a href="/pages/about">Learn more</a></strong></p>
				</div>
			</div>

			<div class="footer-badge-item">
				<div class="badge-icon-circle">
					<img
						src="https://cdn.pathedits.com/Logos/anisa-foundation-logo-icon-on-white-rounded-background.svg"
						alt="Official logo icon of the Anisa Foundation on a rounded white background representing its brand identity."
						width="86"
						height="86"
					/>
				</div>
				<div class="badge-text">
					<p>5% of every dollar we make goes to funding life-changing support in our home of Gaibandha through the <strong><a href="https://anisafoundation.org" target="_blank" rel="noreferrer noopener">Anisa Foundation</a></strong>.</p>
				</div>
			</div>
		</div>
	</div>

	<div id="site-search-modal" aria-hidden="true">
		<header class="site-search-header">
			<h3 class="site-search-title">Search path</h3>
			<a href="#" class="site-search-close" aria-label="Close the search overlay">
				<img src="https://cdn.pathedits.com/Icons/close.svg" alt="Close icon" />
			</a>
		</header>
		<main class="site-search-main" id="wp--skip-link--target">
			<form action="/" method="get" role="search">
				<div class="search-field">
					<div class="site-search-icon">
						<img src="https://cdn.pathedits.com/Icons/search-icon.svg" alt="Magnifying glass icon representing the search functionality." />
					</div>
					<input type="search" name="s" value="" placeholder="Enter a keyword and press enter" spellcheck="false" autofocus />
					<button type="submit" class="btn-path btn-path-blue btn-uppercase">Search</button>
				</div>
			</form>
		</main>
	</div>
</footer>

<style>
	.footer-wrap {
		font-family: 'Asap', sans-serif;
	}

	.footer-body {
		background-color: #2B1B9A;
		color: #ffffff;
		padding: 56px 0 32px;
	}

	.footer-top {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-bottom: 40px;
	}

	.footer-logo {
		height: 40px;
		width: auto;
		display: block;
	}

	.footer-cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: #67b6f4;
		color: #2b1b9a !important;
		border: none;
		border-radius: 8px;
		min-height: 42px;
		padding: 10px 20px;
		font-size: 14px;
		font-weight: 700;
		font-family: 'Asap', sans-serif;
		text-decoration: none;
		transition: background 0.2s;
		white-space: nowrap;
	}

	.footer-cta-btn:hover { background: #79b5ef; }

	.footer-nav-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 24px;
		margin-bottom: 40px;
		align-items: flex-start;
	}

	.footer-col {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-col a {
		font-size: 14px;
		color: rgba(255,255,255,0.8);
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-col a:hover { color: #67b6f4; }

	.footer-col-title {
		font-weight: 600;
		color: rgba(255,255,255,0.9) !important;
	}

	.footer-contact-col { gap: 14px; }

	.footer-email {
		font-size: 15px;
		font-weight: 600;
		color: #ffffff !important;
		text-decoration: none;
	}

	.footer-socials {
		display: flex;
		gap: 14px;
	}

	.social-icon {
		color: rgba(255,255,255,0.75);
		transition: color 0.2s;
		display: flex;
		align-items: center;
	}

	.social-icon:hover { color: #67b6f4; }

	.footer-phones {
		text-align: right;
	}

	.footer-phones p {
		font-size: 13px;
		color: rgba(255,255,255,0.7);
		margin: 0 0 8px;
		line-height: 1.4;
	}

	.footer-phones strong {
		color: #ffffff;
		font-weight: 600;
	}

	.phone-label {
		color: rgba(255,255,255,0.55);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 24px;
		border-top: 1px solid rgba(255,255,255,0.12);
	}

	.footer-copy {
		font-size: 13px;
		color: rgba(255,255,255,0.55);
		margin: 0;
	}

	.footer-legal-links {
		display: flex;
		gap: 20px;
	}

	.footer-legal-links a {
		font-size: 13px;
		color: rgba(255,255,255,0.55);
		text-decoration: none;
	}

	.footer-legal-links a:hover { color: #ffffff; }

	.footer-badge-bar {
		background: linear-gradient(90deg, rgba(163,215,244,1) 0%, rgba(226,222,255,1) 100%);
		padding: 28px 0;
	}

	.footer-badge-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: center;
	}

	.footer-badge-item {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.badge-icon-circle {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		border: 2px solid rgba(255,255,255,0.8);
		background: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		padding: 8px;
		box-sizing: border-box;
	}

	.badge-icon-circle img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	.badge-text p {
		font-size: 14px;
		line-height: 1.55;
		color: #2b1b9a;
		margin: 0;
	}

	.badge-text a {
		color: #2b1b9a;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	#site-search-modal {
		display: none;
	}

	.site-search-header,
	.site-search-main {
		display: none;
	}

	@media (max-width: 1024px) {
		.footer-nav-grid { grid-template-columns: repeat(3, 1fr); }
		.footer-phones { text-align: left; }
	}

	@media (max-width: 700px) {
		.footer-nav-grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
		.footer-badge-inner { grid-template-columns: 1fr; gap: 24px; }
		.footer-bottom { flex-direction: column; align-items: flex-start; }
	}

	@media (max-width: 500px) {
		.footer-nav-grid { grid-template-columns: 1fr; }
	}
</style>
