---
interface Props {
	beforeImg: string;
	afterImg: string;
	beforeAlt?: string;
	afterAlt?: string;
}

const { beforeImg, afterImg, beforeAlt = "Before editing", afterAlt = "After editing" } = Astro.props;
---

<div class="ba-wrapper">
	<div class="ba-card ba-before">
		<span class="ba-label">Before</span>
		<img src={beforeImg} alt={beforeAlt} />
	</div>
	<div class="ba-card ba-after">
		<span class="ba-label ba-label-after">After</span>
		<img src={afterImg} alt={afterAlt} />
	</div>
</div>

<style>
	.ba-wrapper {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
		align-items: stretch;
	}

	.ba-card {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		background: #f8f6fa;
	}

	.ba-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.ba-label {
		position: absolute;
		top: 12px;
		left: 12px;
		background: rgba(43,27,154,0.8);
		color: #ffffff;
		font-family: 'Asap', sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 4px 12px;
		border-radius: 6px;
		text-transform: uppercase;
	}

	.ba-label-after {
		background: rgba(103,182,244,0.9);
	}

	@media (max-width: 600px) {
		.ba-wrapper { grid-template-columns: 1fr; }
	}
</style>
