---
const faqs = [
  { q: "Do you offer a discount on large orders?", a: "Two ways - purchase credit packs (up to 1,200 for $1,000) or contact hello@pathedits.com for custom pricing on 100+ images." },
  { q: "Is there a free trial?", a: "Yes, first 2 images edited free, no credit card required." },
  { q: "How do I see exactly how much my edits will cost?", a: "Our platform gives instant pricing. Custom quotes available for large/unique orders." },
  { q: "Do I need to request a quote?", a: "Not necessarily. Instant pricing available, custom quotes for special needs." },
  { q: "Do you offer rush turnaround?", a: "Yes - six-hour, same-day, and overnight delivery options." },
  { q: "Do you offer recurring subscriptions?", a: "Yes, with predictable pricing and priority service." }
];
---

<section class="faq">
  <div class="container">
    <h2>FAQs about Path services</h2>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <div class="faq-item">
          <button class="faq-question">
            <span>{faq.q}</span>
            <div class="toggle-btn">
              <svg class="plus-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2B1B9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <svg class="minus-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2B1B9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </div>
          </button>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll('.faq-item');
  items.forEach(item => {
    const btn = item.querySelector('.faq-question');
    if (btn) {
      btn.addEventListener('click', () => {
        item.classList.toggle('active');
      });
    }
  });
</script>

<style>
  .faq {
    background: #FFFFFF;
    padding: 80px 0;
  }
  .faq .container {
    max-width: 1440px !important;
    margin: 0 auto;
    padding: 0 32px;
  }
  h2 {
    text-align: center;
    color: #2B1B9A;
    font-family: 'Livvic', sans-serif;
    font-size: 32px;
    font-weight: 600;
    margin: 0 0 54px 0;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .faq-item {
    background: #F8F6FA;
    border-radius: 12px;
    border: 2px solid transparent;
    padding: 24px 32px;
    transition: all 0.3s ease;
  }
  .faq-item.active {
    background: #fff;
    border: 2px solid #2B1B9A;
  }
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: 'Livvic', sans-serif;
    color: #2B1B9A;
    font-size: 24px;
    font-weight: 600;
    text-align: left;
  }
  .toggle-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 4px 14px rgba(43, 27, 154, 0.12);
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    margin-left: 20px;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .toggle-btn svg {
    display: block;
    flex-shrink: 0;
  }
  .minus-icon {
    display: none;
  }
  .faq-item.active .plus-icon {
    display: none;
  }
  .faq-item.active .minus-icon {
    display: block;
  }
  .faq-answer {
    display: none;
    padding-top: 16px;
  }
  .faq-item.active .faq-answer {
    display: block;
  }
  .faq-answer p {
    font-family: 'Asap', sans-serif;
    color: #5F5572;
    font-size: 18px;
    margin: 0;
    line-height: 1.5;
  }

  /* 1. Desktop (>1024px): Default styles above */

  /* 2. Tablet (max-width: 1024px) */
  @media (max-width: 1024px) {
    .faq {
      padding: 60px 0;
    }
    .faq .container {
      padding: 0 24px;
    }
    .faq-question {
      font-size: 22px;
    }
    .toggle-btn {
      width: 52px;
      height: 52px;
    }
  }

  /* 3. Mobile (max-width: 768px) */
  @media (max-width: 768px) {
    .faq {
      padding: 48px 0;
    }
    .faq .container {
      padding: 0 16px;
    }
    .faq-item {
      padding: 20px 24px;
    }
    .faq-question {
      font-size: 18px;
    }
    .toggle-btn {
      width: 44px;
      height: 44px;
    }
    .toggle-btn svg {
      width: 18px;
      height: 18px;
    }
  }
</style>
