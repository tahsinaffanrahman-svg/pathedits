        </div>

        <button class="services-arrow arrow-next" id="services-next" aria-label="Next service">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2B1B9A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </section>

    <!-- Audience Section: Path is perfect for you -->
    <section class="audience-section">
      <div class="container">
        <h2 class="audience-title">Path is perfect for you</h2>
        <p class="audience-subtitle">You don’t have to do everything yourself. Outsourced clipping path services are ideal if you are…</p>
        
        <div class="audience-grid">
          {audiences.map(item => (
            <div class="audience-card">
              <div class="audience-icon">
                <img src={item.icon} alt={item.title} />
              </div>
              <p class="audience-text">
                <strong>{item.title}</strong> {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Trustpilot Reviews Slider Section -->
    <section class="trustpilot-reviews-section">
      <div class="container">
        <div class="slider-header">
          <img src="https://cdn.pathedits.com/Illustrations/trusted-image-editing-services.svg" alt="5-star reviews star" class="reviews-star-icon" />
          <h2 class="reviews-title">Backed by thousands of 5-star reviews</h2>
          <p class="reviews-subtitle">Path has saved 40,000+ businesses valuable time and money with premium image editing services.</p>
        </div>
        <div class="trustpilot-widget-wrap">
          <div class="trustpilot-widget" data-locale="en-US" data-template-id="54ad5defc6454f065c28af8b" data-businessunit-id="614492196d2477001d850c10" data-style-height="250px" data-style-width="100%" data-theme="light" data-stars="1,2,3,4,5" data-review-languages="en">
            <a href="https://uk.trustpilot.com/review/pathedits.com" target="_blank" rel="noopener">Trustpilot</a>
          </div>
        </div>
      </div>
    </section>

    <ReviewsBanner />
    <CtaSection centered={true} />
  </main>
  <Footer />
</Layout>

<script>
  function setupServicesSlider() {
    const track = document.getElementById('services-track');
    const prevBtn = document.getElementById('services-prev');
    const nextBtn = document.getElementById('services-next');

    if (!track || !prevBtn || !nextBtn) return;

    let currentIndex = 0;
    const slides = Array.from(track.querySelectorAll('.service-slide')) as HTMLElement[];
    const totalSlides = slides.length;

    const updateSlider = () => {
      if (window.innerWidth >= 1024) {
        track.style.transform = '';
        return;
      }
      const slideWidth = slides[0]?.offsetWidth || 0;
      const gap = 24;
      const offset = currentIndex * (slideWidth + gap);
      track.style.transform = `translateX(-${offset}px)`;
    };

    prevBtn.addEventListener('click', () => {
      if (window.innerWidth >= 1024) return;
      if (currentIndex === 0) {
        currentIndex = totalSlides - 1;
      } else {
        currentIndex--;
      }
      updateSlider();
    });

    nextBtn.addEventListener('click', () => {
      if (window.innerWidth >= 1024) return;
      if (currentIndex >= totalSlides - 1) {
        currentIndex = 0;
      } else {
        currentIndex++;
      }
      updateSlider();
    });

    window.addEventListener('resize', updateSlider);
    updateSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupServicesSlider);
  } else {
    setupServicesSlider();
  }
</script>

