      <div class="header-inner">
        <div class="header-left">
          <h1>The simple way to<br>get pixel perfect<br>photo edits</h1>
          <div class="subtitle-wrapper">
            <h4>Here’s how we make it easy to get fast,<br>affordable product photo edits — <strong>all done by<br>hand by pro designers.</strong></h4>
          </div>
        </div>
        <div class="header-right">
          <img 
            src="https://cdn.pathedits.com/Images/pages/how-it-works/pixel-perfect-product-photo-edits.png" 
            alt="The simple way to get pixel perfect photo edits illustration"
            class="header-graphic"
          />
        </div>
      </div>
    </section>

    <!-- 5-Step Process Section -->
    <section class="section-how-steps">
      <div class="steps-path-bg"></div>
      <div class="container">
        <div class="steps-list">
          {steps.map(step => (
            <div class="step-row">
              <div class="step-image">
                <img src={step.img} alt={step.alt} loading="lazy" />
              </div>
              <div class="step-content">
                <h2 class="step-number">{step.stepNumber}</h2>
                <h4 class="step-heading">{step.title}</h4>
                <div class="step-text">
                  {step.description.split('\n\n').map(p => (
                    <p>{p}</p>
                  ))}
                  {step.fileTypes && (
                    <ul class="file-types-list">
                      {step.fileTypes.map(ft => (
                        <li class={ft.preferred ? "preferred" : ""}>{ft.name}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pixel Perfect Guarantee Banner -->
    <section class="guarantee-section">
      <div class="container">
        <div class="guarantee-card">
          <div class="guarantee-image">
            <img src="https://cdn.pathedits.com/Illustrations/pixel-perfect-results-illustration.svg" alt="Pixel perfect results" />
          </div>
          <div class="guarantee-info">
            <h2>Pixel perfect guarantee</h2>
            <p>If you’re not 100% happy with your edits, let us know. We’ll make any revisions you need right away.</p>
            <div class="guarantee-cta">
              <a href="/pages/free-trial" class="btn-guarantee">Get started</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Services Section -->
    <section class="popular-services-section">
      <div class="container services-container-rel">
        <h2 class="services-title">Our <strong>most popular</strong> photo-editing services</h2>
        
        <button class="services-arrow arrow-prev" id="services-prev" aria-label="Previous service">
