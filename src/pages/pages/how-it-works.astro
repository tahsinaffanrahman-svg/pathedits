            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="services-viewport" id="services-viewport">
          <div class="services-track" id="services-track">
            {popularServices.map(service => (
              <div class="service-slide">
                <div class="service-item-card">
                  <div class="service-img-wrapper" style={`--backdrop-color: ${service.colorBg};`}>
                    <img src={service.img} alt={service.title} loading="lazy" />
                  </div>
                  <div class="service-content-wrapper">
                    <h3 class="service-name">{service.title}</h3>
                    <p class="service-desc">{service.desc}</p>
                    <div class="service-price">
                      Starting at <span class="price-val">{service.price}</span> per image
                    </div>
                    <div class="service-actions">
                      <a href={service.link} class="btn-view">View details</a>
                      <a href="/pages/free-trial" class="btn-order">Order now</a>
                    </div>
                  </div>
