---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InfoBar from '../../components/InfoBar.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Get 2 Free Edits | Path Edits" description="Try our professional photo editing service risk-free">
  <Header />
  <InfoBar />
  <main>
    <PageHero title="Get 2 Free Edits" subtitle="Try our professional photo editing service risk-free" />
    <section class="trial-section">
      <div class="container">
        <div class="trial-content">
          <h2>How It Works</h2>
          <div class="steps-grid">
            <div class="step">
              <div class="step-num">1</div>
              <h3>Upload</h3>
              <p>Send us 2 images you want edited.</p>
            </div>
            <div class="step">
              <div class="step-num">2</div>
              <h3>We edit</h3>
              <p>Our pros edit your photos quickly.</p>
            </div>
            <div class="step">
              <div class="step-num">3</div>
              <h3>You review</h3>
              <p>Download your free perfect edits.</p>
            </div>
          </div>
          
          <div class="no-card">
            <p><strong>No credit card required.</strong> Just experience our top-tier quality firsthand.</p>
          </div>

          <div class="cta">
            <a href="/pages/free-trial" class="btn">Upload your images →</a>
          </div>

          <div class="social-proof">
            <p>Trusted by thousands of businesses worldwide.</p>
            <div class="trustpilot-rating">
              <span class="stars">★★★★★</span> 4.8 / 5 on Trustpilot
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .container { max-width: 1256px; margin: 0 auto; padding: 40px 20px; }
  .trial-section { background-color: #F8F6FA; }
  .trial-content { background: white; padding: 50px; border-radius: 20px; text-align: center; max-width: 900px; margin: 0 auto; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
  h2 { font-family: 'Livvic', sans-serif; color: #2B1B9A; margin-bottom: 40px; font-size: 2rem; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-bottom: 40px; }
  .step { padding: 20px; }
  .step-num { width: 50px; height: 50px; background-color: #2B1B9A; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-family: 'Livvic', sans-serif; font-weight: 700; margin: 0 auto 20px; }
  h3 { font-family: 'Livvic', sans-serif; color: #332B50; margin-bottom: 10px; }
  p { font-family: 'Asap', sans-serif; color: #5F5572; }
  .no-card { background-color: #F3F1F9; padding: 15px; border-radius: 8px; margin-bottom: 40px; color: #2B1B9A; font-family: 'Asap', sans-serif; }
  .cta { margin-bottom: 40px; }
  .btn { display: inline-block; background-color: #67B6F4; color: #2B1B9A; font-family: 'Asap', sans-serif; font-weight: 700; padding: 15px 40px; border-radius: 8px; text-decoration: none; font-size: 1.2rem; }
  .social-proof { border-top: 1px solid #eee; padding-top: 30px; }
  .trustpilot-rating { font-family: 'Livvic', sans-serif; font-weight: 600; color: #332B50; margin-top: 10px; }
  .stars { color: #00b67a; font-size: 1.2rem; }
  @media (max-width: 768px) {
    .steps-grid { grid-template-columns: 1fr; }
  }
</style>
