---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import InfoBar from '../../components/InfoBar.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';

const faqs = [
  { question: "What types of shadows do you create?", answer: "We offer drop shadow, natural shadow, reflection shadow, and floating shadow services." },
  { question: "Can you match existing lighting?", answer: "Yes, our experts carefully analyze your image's light source to create accurate and realistic shadows." },
  { question: "Do you offer batch processing?", answer: "Absolutely. We can add consistent shadows across an entire catalog of products." }
];
---

<Layout title="Shadow Creation Service | Path Edits" description="Natural-looking shadows that make products look realistic and generate more sales. Starting from $0.25 per image.">
  <Header />
  <InfoBar />
  <main>
    <PageHero title="Shadow Creation Service" subtitle="Natural-looking shadows that make products look realistic and generate more sales" breadcrumb={[{label: 'Services', href: '/pages/services'}]} />
    
    <section class="value-prop section-white">
      <div class="container">
        <div class="split-layout">
          <div class="content">
            <h2>Add depth to your products</h2>
            <p>Give your isolated product photos context and depth. A realistic shadow grounds your product and makes it pop, increasing perceived value and conversion rates.</p>
          </div>
          <div class="image-wrapper">
            <img src="https://cdn.pathedits.com/Images/shared/service-cards/shadow-services-chair-edited.png?w=400" alt="Shadow Creation Service" />
          </div>
        </div>
      </div>
    </section>

    <section class="benefits section-light">
      <div class="container">
        <h2 class="text-center">Enhance reality with our shadow service</h2>
        <div class="grid">
          <div class="card">
            <img src="https://cdn.pathedits.com/Icons/shadow.svg" alt="Drop shadows" width="48" height="48" />
            <h3>Drop shadows</h3>
            <p>Create the illusion that your product is floating slightly above the background.</p>
          </div>
          <div class="card">
            <img src="https://cdn.pathedits.com/Icons/shadow.svg" alt="Natural shadows" width="48" height="48" />
            <h3>Natural shadows</h3>
            <p>Recreate the original shadow or cast a new one based on the light source.</p>
          </div>
          <div class="card">
            <img src="https://cdn.pathedits.com/Icons/shadow.svg" alt="Reflection shadows" width="48" height="48" />
            <h3>Reflection shadows</h3>
            <p>Add a beautiful mirror-like reflection underneath your product.</p>
          </div>
          <div class="card">
            <img src="https://cdn.pathedits.com/Icons/shadow.svg" alt="Consistent lighting" width="48" height="48" />
            <h3>Consistent lighting</h3>
            <p>Maintain uniform shadow directions and intensities across product collections.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pricing section-white">
      <div class="container text-center">
        <h2>Transparent Pricing</h2>
        <p class="price-callout">From <strong>$0.25</strong> per image</p>
        <p>Boost your visual appeal with affordable shadow creation services.</p>
      </div>
    </section>

    <section class="faq-section section-light">
      <div class="container">
        <h2 class="text-center">Frequently Asked Questions</h2>
        <div class="faq-wrapper">
            <FAQ items={faqs} />
        </div>
      </div>
    </section>

    <section class="cta section-white">
      <div class="container text-center">
        <h2>Ready to ground your products?</h2>
        <p>Start adding realistic shadows to your images.</p>
        <a href="/pages/free-trial" class="btn">Get started &rarr;</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .section-white {
    background-color: #ffffff;
    padding: 4rem 1rem;
  }
  .section-light {
    background-color: #F8F6FA;
    padding: 4rem 1rem;
  }
  .container {
    max-width: 1256px;
    margin: 0 auto;
  }
  .text-center {
    text-align: center;
  }
  
  h1, h2, h3 {
    font-family: 'Livvic', sans-serif;
    color: #2B1B9A;
    margin-bottom: 1rem;
  }
  
  p {
    font-family: 'Asap', sans-serif;
    color: #5F5572;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  
  .split-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .split-layout {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .image-wrapper {
    display: flex;
    justify-content: center;
  }
  .image-wrapper img {
    max-width: 100%;
    height: auto;
    border-radius: 20px;
  }
  
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .card {
    background: #ffffff;
    padding: 2rem;
    border-radius: 20px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  }
  .card img {
    margin-bottom: 1rem;
  }
  
  .price-callout {
    font-size: 2.5rem;
    color: #2B1B9A;
    font-weight: 700;
  }
  
  .btn {
    display: inline-block;
    background-color: #67B6F4;
    color: #2B1B9A;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-family: 'Asap', sans-serif;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .btn:hover {
    background-color: #9B93EE;
    color: #ffffff;
  }
  
  .faq-wrapper {
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
  }
</style>
