<script>
  // 1. Carousel Slider functionality
  const track = document.getElementById('sliderTrack');
  const slides = Array.from(track ? track.children : []);
  const prevBtn = document.getElementById('sliderPrev');
  const nextBtn = document.getElementById('sliderNext');
  let currentIdx = 0;

  function getMaxIdx() {
    if (window.innerWidth > 960) return Math.max(0, slides.length - 3); // 3 visible
    if (window.innerWidth > 600) return Math.max(0, slides.length - 2); // 2 visible
    return Math.max(0, slides.length - 1); // 1 visible
  }

  function updateSlider() {
    if (track && slides.length > 0 && slides[0] instanceof HTMLElement) {
      const slideWidth = slides[0].getBoundingClientRect().width;
      const gap = 24;
      const offset = currentIdx * (slideWidth + gap);
      track.style.transform = `translateX(-${offset}px)`;
    }
  }

  prevBtn?.addEventListener('click', () => {
    const maxIdx = getMaxIdx();
    currentIdx = (currentIdx === 0) ? maxIdx : currentIdx - 1;
    updateSlider();
  });

  nextBtn?.addEventListener('click', () => {
    const maxIdx = getMaxIdx();
    currentIdx = (currentIdx >= maxIdx) ? 0 : currentIdx + 1;
    updateSlider();
  });

  window.addEventListener('resize', () => {
    currentIdx = Math.min(currentIdx, getMaxIdx());
    updateSlider();
  });

  // Call once to position correctly
  setTimeout(updateSlider, 100);

  // 3. Dynamic Large Accordion Section functionality
  const faqItems = document.querySelectorAll('.pe-faq-item');

  faqItems.forEach(item => {
    const question = item.querySelector('.pe-faq-question');
    const answer = item.querySelector('.pe-faq-answer');
    
    question?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      
      // Close all other items
      faqItems.forEach(other => {
        if (other !== item) {
          other.classList.remove('active');
          const otherAnswer = other.querySelector('.pe-faq-answer');
          if (otherAnswer instanceof HTMLElement) {
            otherAnswer.style.maxHeight = '';
          }
        }
      });
      
      // Toggle current item
      if (isActive) {
        item.classList.remove('active');
        if (answer instanceof HTMLElement) {
          answer.style.maxHeight = '0px';
        }
      } else {
        item.classList.add('active');
        if (answer instanceof HTMLElement) {
          answer.style.maxHeight = answer.scrollHeight + 100 + 'px';
        }
      }
    });
  });

  // 4. Credits Dropdown Calculator Widget
  const selectElement = document.getElementById("pricing-credits-select");
  const freeVal = document.getElementById("free");
  const totalVal = document.getElementById("total");
  const creditsVal = document.getElementById("btnCredits");
  const buyBtn = document.getElementById("pricing-credits-buy-btn");

  selectElement?.addEventListener("change", (event) => {
    const target = event.target;
    if (target instanceof HTMLSelectElement) {
      const parts = target.value.split('|');
      if (parts.length === 3) {
        if (freeVal) freeVal.textContent = parts[1];
        if (totalVal) totalVal.textContent = parts[0];
        if (creditsVal) creditsVal.textContent = parts[2];
        if (buyBtn) {
          buyBtn.setAttribute('href', `https://dashboard.pathedits.com/credits/c${parts[2]}/purchase`);
        }
      }
    }
  });</script>
