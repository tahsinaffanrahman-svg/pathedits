        <a href="/pages/free-trial" style="background-color: #67B6F4; color: #FFFFFF; font-family: 'Asap', sans-serif; font-size: 16px; padding: 14px 32px; border-radius: 8px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 16px rgba(103, 182, 244, 0.25); transition: all 0.3s ease;">
