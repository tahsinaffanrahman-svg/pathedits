                    <path d="M8.28124 6.33203L8.28128 8.98888L4.39588 11.6654" stroke="#67B6F4" stroke-linecap="square" stroke-miterlimit="10" stroke-width="2"></path>
                    <path d="M8.33333 16.3327C12.3834 16.3327 15.6667 13.0494 15.6667 8.99935C15.6667 4.94926 12.3834 1.66602 8.33333 1.66602C4.28324 1.66602 1 4.94926 1 8.99935C1 13.0494 4.28324 16.3327 8.33333 16.3327Z" stroke="#67B6F4" stroke-linecap="square" stroke-miterlimit="10" stroke-width="2"></path>
