        <h2 class="slider-title">Articles in <strong>Outsourcing</strong></h2>
        
        <div class="splide-carousel-container">
          <!-- Chevron Navigation buttons -->
          <button class="splide-arrow splide-arrow-left outsourcing-prev" aria-label="Previous slide">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
