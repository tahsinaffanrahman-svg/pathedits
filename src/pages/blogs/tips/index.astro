      <!-- Client-side Javascript for the Carousel -->
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const track = document.querySelector('.outsourcing-track');
          const prevBtn = document.querySelector('.outsourcing-prev');
          const nextBtn = document.querySelector('.outsourcing-next');
          if (track && prevBtn && nextBtn) {
            let index = 0;
            const cards = track.querySelectorAll('.slider-card');
            
            function updateSlider() {
              const cardWidth = cards[0].getBoundingClientRect().width + 32; // width + gap
              const cols = window.innerWidth > 960 ? 3 : (window.innerWidth > 600 ? 2 : 1);
              const maxIdx = Math.max(0, cards.length - cols);
              if (index > maxIdx) index = maxIdx;
              if (index < 0) index = 0;
              track.style.transform = `translateX(-${index * cardWidth}px)`;
              
              // Hide/Show arrows on desktop since no scroll is needed
              if (maxIdx === 0) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
              } else {
                prevBtn.style.display = 'flex';
                nextBtn.style.display = 'flex';
                prevBtn.style.opacity = index === 0 ? '0.3' : '1';
                nextBtn.style.opacity = index === maxIdx ? '0.3' : '1';
              }
            }
            
            prevBtn.addEventListener('click', () => {
              if (index > 0) {
                index--;
                updateSlider();
              }
            });
            
            nextBtn.addEventListener('click', () => {
              const cols = window.innerWidth > 960 ? 3 : (window.innerWidth > 600 ? 2 : 1);
              const maxIdx = Math.max(0, cards.length - cols);
              if (index < maxIdx) {
                index++;
                updateSlider();
              }
            });
            
            window.addEventListener('resize', updateSlider);
            updateSlider();
            // Run a slight delay hook for correct rendering widths
            setTimeout(updateSlider, 200);
          }
        });
      </script>

    </div>

    <!-- Centered Final CTA Section -->
